# Copy to .env (same folder) before running docker compose. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=pragmattie_sync
MYSQL_USER=pragmattie_sync
MYSQL_PASSWORD=pragmattie_sync

# GitHub access for the orchestrator (signals collector and backlog script).
# A fine-grained personal access token limited to this one repository.
GITHUB_TOKEN=
GITHUB_REPO=geoffsmattie/pragmattie-sync

# Used later by the agents (Phase 4). Locally only; in GitHub it is a repo secret.
ANTHROPIC_API_KEY=

# The PR risk agent (Phase 4). Start it with: docker compose --profile agents up -d
#   off      does nothing at all (the default)
#   shadow   comments on and labels PRs and records decisions; the risk-gate check always passes
#   enforce  the risk-gate check is real
ORCHESTRATOR_MODE=off
RISK_MODEL=claude-sonnet-5
# The planner drafts scope options when the sprint forecast slips (Phase 5; proposes only).
PLANNER_MODEL=claude-sonnet-5
POLL_SECONDS=30
